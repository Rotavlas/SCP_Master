# Mode en ligne (facultatif) : sans ces variables, le jeu reste entièrement local.
# Valeurs dans Supabase → Project Settings → API. La clé publique (publishable / anon) peut être exposée au navigateur :
# ce sont les règles RLS et les fonctions SQL qui protègent les données.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Fournisseurs OAuth activés dans Supabase → Authentication → Providers (séparés par des virgules)
VITE_SUPABASE_FOURNISSEURS=discord,google
